# Postgres connection string (Tiger Data / Timescale cloud connection string, or any Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname

# Google AI Studio key -> https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Resend API key -> https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Public URL this app is running at (used to build the partner share link)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
